{
  "servers": {
    "web_frontend": {
      "title": "Web Application (Frontend - Vite/React)",
      "project": "web-app",
      "service": "frontend",
      "default_port": 3000,
      "cwd": "./frontend",
      "command": ["npm", "run", "dev", "--", "--port", "{port}"],
      "env": {}
    },
    "api_backend": {
      "title": "API Service (Backend - FastAPI)",
      "project": "web-app",
      "service": "backend",
      "default_port": 8000,
      "cwd": "./backend",
      "command": ["python3", "-m", "uvicorn", "main:app", "--port", "{port}", "--host", "0.0.0.0"],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "aliases": {
    "app": ["web_frontend", "api_backend"],
    "web": ["web_frontend"],
    "api": ["api_backend"]
  }
}
