# ====================================================================
# HorusOps / git-auto-sync Environment Variables Template
# Copy this file to .env or use `python3 setup_wizard.py` to configure via Web UI.
# ====================================================================

# --- Telegram Bot Configuration ---
# Your Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# Your personal numerical Telegram User ID (obtained from @userinfobot)
# Only this user ID will be permitted to command the bot
TELEGRAM_USER_ID="123456789"

# --- AI Provider Configuration (Groq Cloud) ---
# Your Groq API key from https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Model identifier: "qwen/qwen3.8-27b", "llama-3.3-70b-versatile", or "llama-3.1-8b-instant"
GROQ_MODEL="qwen/qwen3.8-27b"

# --- GitHub Integration Token ---
# GitHub Personal Access Token (classic with repo & workflow scopes, or fine-grained)
GITHUB_TOKEN="ghp_your_github_token_here"

# --- Multi-Repo Git Sync Settings ---
# Base directory containing all your git repositories to scan and sync
SYNC_BASE_DIR="~/projects"

# Comma-separated directory names to completely ignore from syncing
SYNC_IGNORED_NAMES="ignore,personal,archive"
